  "red_flags": [
    "Chest pain with diaphoresis, nausea or vomiting",
    "Sudden tearing pain radiating to the interscapular back",
    "Chest pain with syncope or near-syncope",
    "Hypotension (SBP < 90 mmHg) or clinical shock",
    "New severe dyspnoea or SpO2 < 92% with the pain",
    "Pleuritic pain with unilateral leg swelling or haemoptysis"
  ],
  "exam": [
    "Measure blood pressure in BOTH arms — a difference > 20 mmHg supports dissection",
    "Palpate radial pulses together for radio-radial delay or deficit",
    "Count respiratory rate and record SpO2 on room air",
    "Auscultate the heart for a new early diastolic murmur (aortic regurgitation of dissection), pericardial rub, or muffled sounds",
    "Auscultate both lungs for focal crackles, bronchial breathing, absent breath sounds, or pleural rub",
    "Inspect and estimate JVP — raised in tamponade, right-heart strain of PE, heart failure",
    "Press on the costochondral junctions and chest wall — full reproduction of the pain points away from visceral causes",
    "Examine both calves for unilateral swelling, tenderness, or oedema (DVT as PE source)",
    "Palpate the epigastrium for tenderness suggesting an upper-GI source",
    "Inspect the chest wall skin for a vesicular dermatomal rash (early zoster mimicking cardiac pain)"
  ],
  "investigations": [
    {
      "test": "ECG (repeat if pain persists)",
      "why": "First-line for ACS — ST elevation/depression or new T-wave inversion rules it in; diffuse saddle-shaped ST elevation with PR depression supports pericarditis; S1Q3T3 or new RBBB with sinus tachycardia supports PE; a normal serial ECG makes ACS less likely but does not exclude it"
    },
    {
      "test": "Troponin (at presentation and repeat per lab assay window)",
      "why": "Separates ACS with myocardial injury from stable angina, GERD, musculoskeletal and panic causes; a negative serial troponin with a normal ECG effectively rules out infarction; mildly raised values also occur in PE and myopericarditis — interpret with the ECG"
    },
    {
      "test": "Chest X-ray",
      "why": "Rules in pneumonia (consolidation) and pneumothorax; a widened mediastinum raises dissection; a normal film supports ACS, GERD, musculoskeletal or panic causes over pleuro-pulmonary ones"
    },
    {
      "test": "CBC",
      "why": "Leukocytosis supports pneumonia or pericarditis over ACS; significant anaemia can precipitate angina and changes the weight given to ischaemic pain"
    },
    {
      "test": "CRP or ESR",
      "why": "Raised in pericarditis and pneumonia; typically normal in stable angina, GERD, and musculoskeletal pain — helps arbitrate when ECG is equivocal"
    },
    {
      "test": "D-dimer",
      "why": "Only when PE pre-test probability is LOW — a negative result then rules out PE; do not send when probability is high (a positive adds nothing and a negative cannot exclude)"
    },
    {
      "test": "Renal function and electrolytes",
      "why": "Potassium and renal status alter ECG interpretation (mimics of ischaemic change) and are needed before any contrast imaging for dissection or PE"
    },
    {
      "test": "CT pulmonary angiography / CT aortography",
      "why": "Second-line — only if PE probability is high or D-dimer positive (CTPA), or if both-arm BP difference, tearing pain, or widened mediastinum raise dissection (CT aortogram); confirms or excludes these two lethal diagnoses"
    }
  ],
